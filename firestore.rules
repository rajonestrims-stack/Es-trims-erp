rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() in [
          'rajonpaul300@gmail.com',
          'esstore@gmail.com',
          'rajon.estrims@gmail.com'
        ]
      );
    }

    // RBAC Lookup
    function getUserProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isOwner(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    // Master Gate (Business Membership)
    function isBusinessMember(businessId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        businessId == 'default' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserProfile(request.auth.uid).businessId == businessId
        )
      );
    }

    function isEditor() {
      return isSignedIn();
    }

    // --- Collection Routes ---

    match /users/{uid} {
      allow read, write: if isSignedIn();
    }

    match /roles/{roleId} {
      allow read, write: if isSignedIn();
    }

    match /userRoles/{roleId} {
      allow read, write: if isSignedIn();
    }

    match /user_roles/{roleId} {
      allow read, write: if isSignedIn();
    }

    match /approval_rules/{id} {
      allow read, write: if isSignedIn();
    }

    match /employees/{id} {
      allow read, write: if isSignedIn();
    }

    match /designations/{id} {
      allow read, write: if isSignedIn();
    }

    match /departments/{id} {
      allow read, write: if isSignedIn();
    }

    match /audit_logs/{id} {
      allow read, write: if isSignedIn();
    }

    match /auditLogs/{id} {
      allow read, write: if isSignedIn();
    }

    match /system_settings/{id} {
      allow read, write: if isSignedIn();
    }

    match /categories/{categoryId} {
      allow read, write: if isSignedIn();
    }

    match /salesCategories/{id} {
      allow read, write: if isSignedIn();
    }

    match /sales_categories/{id} {
      allow read, write: if isSignedIn();
    }

    match /items/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /transactions/{transactionId} {
      allow read, write: if isSignedIn();
    }

    match /formulas/{formulaId} {
      allow read, write: if isSignedIn();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isSignedIn();
    }

    match /purchaseOrders/{poId} {
      allow read, write: if isSignedIn();
    }

    match /purchase_orders/{poId} {
      allow read, write: if isSignedIn();
    }

    match /supplierPayments/{paymentId} {
      allow read, write: if isSignedIn();
    }

    match /supplier_payments/{paymentId} {
      allow read, write: if isSignedIn();
    }

    match /approvalRequests/{requestId} {
