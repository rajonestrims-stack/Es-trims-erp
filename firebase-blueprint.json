      "schema": "UserRolePermission",
      "description": "Custom user roles and page permission settings"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of item categories"
    },
    "/items/{itemId}": {
      "schema": "Item",
      "description": "Collection of inventory items"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
