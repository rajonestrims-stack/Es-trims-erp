    "/coa_groups/{id}": {
      "schema": "CoaGroup",
      "description": "Chart of accounts master groups"
    },
    "/coa_categories/{id}": {
      "schema": "CoaCategory",
      "description": "Chart of accounts categories"
    },
    "/coa_subcategories/{id}": {
      "schema": "CoaSubCategory",
      "description": "Chart of accounts sub-categories"
